; Engine configuration file for "The First Layer".
; Godot 4.x. Most runtime config (input map, render quality) is set in code
; via autoloads so this file stays small and robust across versions.

config_version=5

[application]

config/name="The First Layer"
config/description="A Magical Forest Simulation Mystery - vertical slice prototype."
run/main_scene="res://scenes/MainMenu.tscn"
config/features=PackedStringArray("4.2", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

Boot="*res://scripts/autoload/Boot.gd"
SettingsManager="*res://scripts/autoload/SettingsManager.gd"
AudioManager="*res://scripts/autoload/AudioManager.gd"
SaveManager="*res://scripts/autoload/SaveManager.gd"
GameState="*res://scripts/autoload/GameState.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[rendering]

renderer/rendering_method="forward_plus"
environment/defaults/default_clear_color=Color(0.03, 0.05, 0.06, 1)
anti_aliasing/quality/msaa_3d=1
textures/vram_compression/import_etc2_astc=true
lights_and_shadows/directional_shadow/size=2048
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=2
